# Per-install settings written next to config.yaml (data root).
nib-settings.json

handler/nib-handler
handler/nib-handler.exe
handler/dist/

bin/nib-handler
bin/nib-handler.exe
bin/**/nib-handler-*

# Downloaded weights and docker files. Keep the directory.
artifacts/*
!artifacts/.gitkeep

# Generated release resources (manifest/Dockerfile copy).
resources/

# Diagnostics run outputs. Keep the directory.
runs/*
!runs/.gitkeep

# model weights
# *.bin is intentionally omitted: CMA radar observations use that suffix.
*.onnx
*.onnx.data
*.ckpt
*.pt
*.pth
*.pb
*.tflite
*.ort
*.msgpack
*.gguf
*.h5
*.hdf5
*.safetensors

# Local observation samples. Not demo fixtures.
/data/
testdata/

# Design drafts stay on disk. Git keeps markdown.
*.pdf
*.doc
*.docx
*.docm
*.vsdx
~$*

.DS_Store
