.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.codegraph/
.opencode/
.claude/
.pi/
.vscode/

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

workspace/
tmp/
.env

handler/nib-handler
handler/nib-handler.exe
handler/dist/

bin/nib-handler
bin/nib-handler.exe
bin/**/nib-handler-*

# Downloaded weights and docker files. Keep the directory.
artifacts/*
!artifacts/.gitkeep

# Diagnostics run outputs. Keep the directory.
runs/*
!runs/.gitkeep

# Weights never belong in git. Extension list, not a blanket binary rule.
# *.bin is intentionally omitted: CMA radar observations use that suffix.
*.onnx
*.onnx.data
*.ckpt
*.pt
*.pth
*.pb
*.tflite
*.ort
*.msgpack
*.gguf
*.h5
*.hdf5
*.safetensors

# Local observation samples. Not demo fixtures.
/data/
testdata/

# Design drafts stay on disk. Git keeps markdown.
*.pdf
*.doc
*.docx
*.docm
*.vsdx
~$*

.DS_Store

# Local scratch: run copies, generated stores, benchmark output. The store for a
# year of fake results is several gigabytes, and it is reproducible from
# diagnostics/verification/tools/make_year.py -- nothing here belongs in git.
_tmp/
